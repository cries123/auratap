VITE_CONTACT_EMAIL=support@aurataps.net
VITE_BOOKING_URL=https://calendly.com/your-handle/auratap-demo
VITE_BUSINESS_ADDRESS=Nationwide

# The address your site and customers' tap links live at, e.g. https://aurataps.net.
# Used for canonical/link-preview tags, the sitemap, and the links shown in the member portal.
# Leave empty to use https://aurataps.net.
VITE_PUBLIC_SITE_URL=

# Optional: Google Analytics 4 Measurement ID (example: G-ABC123XYZ)
VITE_GA_MEASUREMENT_ID=

# Optional: only set these if the API is on a different domain than the site.
# By default the site calls /api on its own domain; Firebase Hosting (firebase.json) and
# Netlify (netlify.toml) both forward it to the function.
VITE_CHAT_API_BASE=
VITE_ADMIN_API_BASE=
VITE_MEMBER_API_BASE=
