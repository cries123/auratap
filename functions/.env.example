# Copy to functions/.env before deploying. Firebase loads it into the function automatically.
# Never commit the real .env (it is gitignored).

# Required: password for /admin. Admin login is disabled while this is empty.
ADMIN_PASSWORD=

# Public site address, used in password reset emails and saved contact cards.
FRONTEND_URL=https://auratap-ee8a0.web.app

# Email via Resend (https://resend.com). Needed for password reset emails,
# new-message alerts, and emailing your admin replies to visitors.
RESEND_API_KEY=
EMAIL_FROM=Aura Tap <support@yourdomain.com>
ADMIN_EMAIL=

# Optional: Telegram alerts for new chats, and replying from Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
# Any long random string; also passed to setWebhook (see functions/README.md).
TELEGRAM_WEBHOOK_SECRET=

# Optional: extra comma-separated origins allowed to call the API.
CORS_ORIGINS=
