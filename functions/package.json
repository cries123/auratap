{
  "name": "auratap-functions",
  "description": "Aura Tap backend API on Firebase Functions",
  "type": "module",
  "main": "index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "serve": "firebase emulators:start --only auth,functions,firestore",
    "test": "firebase emulators:exec --only auth,functions,firestore --project demo-auratap \"node --test test/*.test.js\"",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions,firestore",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^5.0.0"
  }
}
